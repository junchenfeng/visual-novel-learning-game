  "poem": {
    "schemaVersion": 1,
    "title": "赤壁",
    "lines": [
      {
        "id": "line_01",
        "original": "折戟沉沙铁未销",
        "translation": "一支折断的戟沉埋在沙里，铁还没有完全销蚀。",
        "note": "一件从沙里捞起的旧兵器，牵出诗人对一场旧战的追想——这叫借物起兴。",
        "glosses": [
          {
            "word": "折戟",
            "meaning": "折断的戟，古代的一种兵器"
          },
          {
            "word": "销",
            "meaning": "销蚀、腐蚀"
          }
        ]
      },
      {
        "id": "line_02",
        "original": "自将磨洗认前朝",
        "translation": "我把这支戟拿起来磨洗，认出它是前朝（三国时代）的遗物。",
        "glosses": [
          {
            "word": "磨洗",
            "meaning": "打磨清洗"
          },
          {
            "word": "前朝",
            "meaning": "指三国时期"
          }
        ]
      },
      {
        "id": "line_03",
        "original": "东风不与周郎便",
        "translation": "倘若当年东风不给周郎方便（相助）。",
        "note": "东风不只是天气，它像「机遇」：周瑜的胜利，成就在这一阵风上。",
        "glosses": [
          {
            "word": "周郎",
            "meaning": "周瑜"
          },
          {
            "word": "便",
            "meaning": "便利、相助；这里是“倘若……相助”"
          }
        ]
      },
      {
        "id": "line_04",
        "original": "铜雀春深锁二乔",
        "translation": "那么大乔、小乔，大概早已被锁进春深重重的铜雀台里了。",
        "note": "不说东吴整个败了，只写二乔被锁进铜雀台——用两个人影，代指一国之亡（以小见大）。",
        "glosses": [
          {
            "word": "铜雀",
            "meaning": "铜雀台，曹操在邺城所建之台"
          },
          {
            "word": "二乔",
            "meaning": "大乔、小乔，孙策与周瑜之妻，这里代指东吴"
          }
        ]
      }
    ]
  },
  "quiz": {
    "schemaVersion": 1,
    "gradingPrompt": "本课围绕杜牧《赤壁》的史实（赤壁之战、咏史）、东风象征机遇、二乔以小见大，以及借史抒怀（怀才不遇）。\n选择与填空都先看学生是否理解“东风＝机遇”和“二乔代指东吴、以小见大”。\n不要因为剧情里选了哪条正路而改变评价。用适合 10 到 12 岁的话解释，不要嘲讽。\n",
    "summaryPrompt": "请根据本课作答，写一段给 10 到 12 岁学生的总评。\n先肯定他认真走进周瑜与杜牧的故事；再点出东风机遇、借史抒怀还不清楚的地方；最后用“东风不与周郎便”收束，鼓励他把“机遇”“怀才不遇”记住。\n",
    "questions": [
      {
        "id": "q_year",
        "type": "choice",
        "prompt": "杜牧回望的这场赤壁之战，发生在哪一年？",
        "options": [
