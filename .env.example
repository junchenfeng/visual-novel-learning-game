# 复制为 .env.local 后按需填写。
# 扣子部署：保持 AI_PROVIDER 为空，使用扣子 LLM SDK。
# 本机：
#   AI_PROVIDER=mock      Mock 老师，无需密钥
#   AI_PROVIDER=deepseek  OpenAI 兼容的 DeepSeek（密钥只写 .env.local）
#   AI_PROVIDER=openai    其它 OpenAI 兼容接口

AI_PROVIDER=
AI_MODEL=doubao-seed-2-0-lite-260215

# 本机 DeepSeek 示例（不要把真实密钥提交到 git）：
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=
# AI_MODEL=deepseek-v4-flash
