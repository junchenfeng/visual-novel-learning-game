{
  "name": "rpg-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile:dlc": "tsx scripts/compile-dlc.ts",
    "sync:cdn": "tsx scripts/sync-static-to-oss.ts",
    "predev": "tsx scripts/compile-dlc.ts",
    "dev": "node scripts/dev-preview.mjs",
    "prebuild": "tsx scripts/compile-dlc.ts",
    "build": "next build",
    "deploy:build": "pnpm install --frozen-lockfile && pnpm run build && pnpm run sync:cdn",
    "start": "next start -p ${DEPLOY_RUN_PORT:-3000}",
    "start:ecs": "next start -p ${DEPLOY_RUN_PORT:-3010}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "mcp:ingest": "tsx src/mcp/stdio.ts",
    "coze:sync": "node scripts/coze-sync.mjs",
    "coze:sync:write": "node scripts/coze-sync.mjs --write",
    "coze:check": "node scripts/coze-sync.mjs --check",
    "coze:verify": "node scripts/coze-sync.mjs --verify"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@xstate/react": "^6.1.0",
    "ali-oss": "^6.23.0",
    "coze-coding-dev-sdk": "^0.7.24",
    "howler": "^2.2.4",
    "jszip": "^3.10.2",
    "mcp-handler": "^2.1.1",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "xstate": "^5.32.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/howler": "^2.2.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  }
}
